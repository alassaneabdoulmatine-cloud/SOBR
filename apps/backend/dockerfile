# ─── Base ────────────────────────────────────────────────────────────────────
FROM node:24.19.0-bookworm-slim AS base

WORKDIR /app

ENV CI=true

RUN npm install -g pnpm@11.22.0


# ─── Prune monorepo ──────────────────────────────────────────────────────────
FROM base AS pruner

COPY . .

RUN pnpm dlx turbo prune backend --docker


# ─── Install dependencies ────────────────────────────────────────────────────
FROM base AS deps

COPY --from=pruner /app/out/json/ ./

RUN pnpm install --frozen-lockfile


# ─── Build ───────────────────────────────────────────────────────────────────
FROM base AS builder

COPY --from=deps /app/ ./
COPY --from=pruner /app/out/full/ ./

RUN pnpm turbo run build --filter=backend

# Remove development dependencies
RUN pnpm prune --prod


# ─── Runtime ─────────────────────────────────────────────────────────────────
FROM node:24.19.0-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
# Même précaution que côté frontend, même si le backend ne l'a pas déclenché ce coup-ci :
# pnpm 11 vérifie par défaut node_modules avant tout script pnpm et peut tenter
# une réinstallation. On désactive pour un runtime prévisible et rapide.
ENV PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false

# On copie TOUT le monorepo élagué depuis builder, pas juste dist/package.json/node_modules
# racine séparément : pnpm place les symlinks de deps directes (@nestjs/core, etc.)
# dans apps/backend/node_modules, et "aplatir" cassait cette résolution -> MODULE_NOT_FOUND.
COPY --from=builder --chown=node:node /app ./

# --chown sur COPY ne rend pas /app (créé par WORKDIR, donc root) writable.
RUN chown node:node /app

# Run as the unprivileged Node.js user
USER node

EXPOSE 3000

CMD ["node", "apps/backend/dist/main.js"]